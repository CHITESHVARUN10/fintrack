# --- Database ---
# Local dev default:
mongo_uri=mongodb://localhost:27017/fintrack
MONGODB_URI=mongodb://localhost:27017/fintrack
# Production (Atlas) — preferred on Render. db.js/app.js read
# MONGODB_URI first, then mongo_uri_production, then mongo_uri.
# mongo_uri_production=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/fintrack

# --- Server ---
# Render injects PORT automatically; local default is 3000.
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- AI (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
# Required for live Form 16 extraction & tax recommendations.
# Leave as the placeholder to use built-in mock fallbacks in dev.
GEMINI_API_KEY=your-gemini-api-key

# --- CORS ---
# OPTIONAL. app.js already allows localhost dev + https://fintrack.vercel.app.
# Set this only to ADD more browser origins later (comma-separated).
# Native mobile apps need no entry — they send no Origin header.
# CORS_ORIGIN=https://admin.example.com
# Note: in production (NODE_ENV=production) session cookies use
# SameSite=None + Secure with trust proxy, so cross-origin frontends work.

# --- Email (SMTP, optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM="FinTrack" <noreply@example.com>
